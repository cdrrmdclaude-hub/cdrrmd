{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fxstfcbpeydytulbbque.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cdrrmd",
      "version": "0.1.0",
      "title": "CDRRMD"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Get the signed-in employee's CDRRMD profile: name, email, department, position and employment status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_balances",
        "title": "Get my balances",
        "description": "Get the signed-in employee's overtime credits, duty day-off credits, offset hours used and per-leave-type day balances.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_leave_types",
        "title": "List leave types",
        "description": "List the active leave types (e.g. Sick Leave, Vacation Leave) with their codes and default day allowances.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_requests",
        "title": "List my requests",
        "description": "List the signed-in employee's leave, overtime, duty day-off and offset requests, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ],
              "description": "Only return requests with this status."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of requests to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_request",
        "title": "Submit a request",
        "description": "Submit a new request for the signed-in employee. Types: 'leave' (needs leave_type_id and days), 'overtime' or 'duty' (needs start_time/end_time and hours), 'offset' (needs days; hours = days x 8). Requests are created as pending and must be approved by an admin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "leave",
                "overtime",
                "duty",
                "offset"
              ],
              "description": "Request type."
            },
            "start_date": {
              "type": "string",
              "description": "Start date in YYYY-MM-DD format."
            },
            "end_date": {
              "type": "string",
              "description": "End date in YYYY-MM-DD format; must be on or after start_date."
            },
            "reason": {
              "type": "string",
              "description": "Reason or purpose for the request."
            },
            "leave_type_id": {
              "type": "string",
              "description": "Leave type id, required when type is 'leave'."
            },
            "start_time": {
              "type": "string",
              "description": "Start time HH:MM, for overtime/duty."
            },
            "end_time": {
              "type": "string",
              "description": "End time HH:MM, for overtime/duty."
            },
            "hours": {
              "type": "number",
              "description": "Hours requested (0-24), for overtime/duty."
            },
            "days": {
              "type": "number",
              "description": "Days requested (0-365), for leave/offset."
            }
          },
          "required": [
            "type",
            "start_date",
            "end_date",
            "reason"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_pending_requests",
        "title": "List pending requests (admin)",
        "description": "List pending requests across all employees. Only returns rows the signed-in user is allowed to see, so non-admins see only their own.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of requests to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
